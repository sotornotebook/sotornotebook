# WhatsApp number that receives orders (international format, digits only, no +)
VITE_WHATSAPP_NUMBER=201000000000
# Optional: endpoint that receives the workshop sign-up form as JSON (POST).
# If empty, the sign-up opens WhatsApp instead.
VITE_SIGNUP_ENDPOINT=
# Public site URL (used for canonical + OG tags)
VITE_SITE_URL=https://color-alley.vercel.app
